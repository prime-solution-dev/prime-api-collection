meta {
  name: Confirm Packing - 100% picking short
  type: http
  seq: 1
}

docs {
  Confirm pack ของ order ที่ picking_method = FULL แต่ pack ยังไม่ครบ ต้องโดนปฏิเสธ 400
  body: {"error": "cannot confirm: order <no> is 100% picking, items not fully packed: ..."}
  ตั้ง orderNo / outboundCode / packingCode ของใบที่ pack ไม่ครบเอง; token ใส่ผ่าน --env-var ห้าม commit
}

post {
  url: {{PACK_URL}}/packing/confirm-packing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "order_no": "{{orderNo}}",
    "outbound_code": "{{outboundCode}}",
    "packing_code": "{{packingCode}}"
  }
}

tests {
  test("400", function () { expect(res.status).to.equal(400); });
  test("100% picking message", function () { expect(res.body.error).to.contain("100% picking"); });
}
