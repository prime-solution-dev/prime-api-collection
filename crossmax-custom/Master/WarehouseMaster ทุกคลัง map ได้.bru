docs {
  ส่งเฉพาะ WH-DS/WH-PKRP (ชื่อเดิม): ต้องตอบ SUCCESS
  เขียนข้อมูลบน env: ยิงบน UAT ต้องได้อนุญาตจากผู้ใช้ก่อน. ไม่ต้องใช้ token (middleware ไม่ตรวจ auth)
}

post {
  url: {{CROSSMAX_URL}}/Api/Master/WarehouseMaster
  body: json
  auth: none
}

