meta {
  name: Import Product Unit
  type: http
  seq: 2
}

docs {
  POST /Product/import-product-unit: รับแถว unit ที่ reports parse แล้ว (JSON) ตรวจ master + upsert product_unit / barcode
  body: { company_code, site_code, rows: [unitImportRow] }
  ต้องรันหลัง "Import Product" (product QA-IMPORT-001 ต้องมีแล้ว) แถวนี้คือ base unit PCS จึงต้อง ratio = 1
  ตั้ง env: companyCode, siteCode
  คาดหวัง: 200 { status: "success", summary, warnings }
}

post {
  url: {{PRODUCT_URL}}/Product/import-product-unit
  body: json
  auth: inherit
}

body:json {
  {
    "company_code": "{{companyCode}}",
    "site_code": "{{siteCode}}",
    "rows": [
      {
        "row": 2,
        "product_code": "QA-IMPORT-001",
        "unit_code": "PCS",
        "ratio": 1,
        "weight": 0.5
      }
    ]
  }
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
  test("status success", function () { expect(res.body.status).to.equal("success"); });
}
