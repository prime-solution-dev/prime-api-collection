meta {
  name: Import Product Invalid Row
  type: http
  seq: 4
}

docs {
  กฎระดับแถวที่ core ตรวจเองก่อนแตะ DB (กันคนยิง JSON ตรงหรือ reports มี bug): product_code ว่าง
  คาดหวัง: 400 { error: "validation failed", errors: [{ row: 2, column: "Product Code*", message: "Row 2: Product Code is required." }] }
  ไม่เขียนอะไรเลย ตั้ง env: companyCode, siteCode
}

post {
  url: {{PRODUCT_URL}}/Product/import-product
  body: json
  auth: inherit
}

body:json {
  {
    "company_code": "{{companyCode}}",
    "site_code": "{{siteCode}}",
    "rows": [
      {
        "row": 2,
        "product_code": "  ",
        "product_name": "QA Import Invalid Row",
        "base_unit": "PCS"
      }
    ]
  }
}

tests {
  test("400", function () { expect(res.status).to.equal(400); });
  test("product code required on row 2", function () {
    expect(res.body.errors[0].row).to.equal(2);
    expect(res.body.errors[0].message).to.equal("Row 2: Product Code is required.");
  });
}
