meta {
  name: Find Stock In Warehouse
  type: http
  seq: 1
}

docs {
  หาสต็อกที่ใช้เป็น srcLocation ได้ (ดู storage_type / receive_date / batch / pallet ของแถวที่เลือกแล้วใส่ใน env)
