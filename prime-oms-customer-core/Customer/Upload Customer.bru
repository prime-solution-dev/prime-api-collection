meta {
  name: Upload Customer
  type: http
  seq: 1
}

docs {
  อัปโหลด Excel เทมเพลต UAT_7 (4 sheet: Information / Sold to / Bill to / Ship to) เพื่อ upsert customer
  ตั้ง {{uploadFile}} เป็น path ไฟล์ .xlsx ในเครื่อง (ห้าม commit ไฟล์ลูกค้าจริง)
  ไฟล์เทมเพลตเก่า (UAT_4) ต้องได้ 500 "header column N1 ไม่ตรงเทมเพลต UAT_7"
  ผลข้างเคียง: hook CUSTOMER_TO_SAB (SAP BusinessPartnerSync) + CUSTOMER_TO_WMS (WMS create-customer-wms) ถูกเรียกต่อ
  รันด้วย CLI: --env-var uploadFile=/path/file.xlsx
}

post {
  url: {{OMS_CUSTOMER_URL}}/Customer/UploadCustomer
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file({{uploadFile}})
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
  test("success", function () { expect(res.body.status).to.equal("success"); expect(res.body.id.length).to.be.above(0); });
}
