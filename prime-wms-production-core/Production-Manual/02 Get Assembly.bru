meta {
  name: 02 Get Assembly
  type: http
  seq: 2
}

docs {
  status ของ manual เป็นค่า derive: TEMP (Draft) / NEW / PARTIAL GR / GR COMPLETED / COMPLETED / CANCELED
  (ไม่มี PENDING PICK / PENDING GR — เบิกของแล้วยังไม่ GR = NEW, ทุก output GR ครบยอด plan = GR COMPLETED)
  เก็บ assembly_id + input id ไว้ใช้ใน 03 Submit
}

post {
  url: {{PROD_URL}}/assembly/get-assembly
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "page": 1,
    "page_size": 10,
    "assembly_code": ["{{assemblyCode}}"],
    "assembly_type": ["PRODUCTION_MANUAL"]
  }
}

script:post-response {
  const a = ((res.body || {}).assemblys || [])[0];
  if (a) {
    bru.setVar("assemblyId", a.assembly_id);
    const inputs = ((a.items || [])[0] || {}).inputs || [];
    bru.setVar("inputIds", JSON.stringify(inputs.map(i => ({ id: i.id, warehouse_code: "" }))));
    const output = (((a.items || [])[0] || {}).outputs || [])[0];
    if (output) bru.setVar("outputItem", output.output_item);
  }
}

tests {
  test("found", function () {
    expect(res.status).to.equal(200);
    expect(res.body.assemblys.length).to.equal(1);
  });
}
