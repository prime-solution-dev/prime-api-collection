meta {
  name: 03 Submit Draft
  type: http
  seq: 3
}

docs {
  Draft → New (TEMP → PENDING) และสร้าง Plan GR (inbound_type IB_PRODUCTION_MANUAL) ทันที
  manual ไม่บังคับ warehouse ราย input
}

post {
  url: {{PROD_URL}}/production/submit-production
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "assembly_id": "{{assemblyId}}",
    "warehouse_code": "{{warehouseCode}}",
    "production_staging": "{{productionStaging}}",
    "inputs": {{inputIds}}
  }
}

tests {
  test("submitted", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("success");
  });
}
