meta {
  name: 03 Assert RFP-Return
  type: http
  seq: 3
}

docs {
  แถว MANUAL_RETURN (ref = แถว usage รอบ 1) RETURNED + is_send_interface = true (ReceiptfromProductionReturn)
  แถว usage ทุกรอบไม่ถูกส่ง IFP ซ้ำ (return ไม่เข้า IFP)
  เก็บ snapshot สถานะส่ง SAP ทุกแถวไว้เทียบหลัง complete (05)
}

post {
  url: {{PROD_URL}}/production/get-production-detail
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "production_code": "{{assemblyCode}}"
  }
}

script:post-response {
  const items = ((res.body || {}).data || {}).items || [];
  const all = items.flatMap(i => [].concat(
    (i.input_items || []).flatMap(x => x.confirms || []),
    (i.output_items || []).flatMap(x => x.confirms || [])));
  bru.setVar("snapshotBeforeComplete", JSON.stringify(all.map(c => [c.id, c.is_send_interface, c.qty_interface, c.is_send_grpo])));
}

tests {
  const items = res.body.data.items || [];
  const inConf = items.flatMap(i => (i.input_items || []).flatMap(x => x.confirms || []));
  const outConf = items.flatMap(i => (i.output_items || []).flatMap(x => x.confirms || []));
  // รอบ usage แยกด้วยสินค้า: รอบ 1 = u1Product, รอบ 2 = u2Product
  const usage = k => inConf.filter(x => x.document_ref_type === "MANUAL_USAGE" && x.product_code === bru.getEnvVar(k + "Product"));
  const outOf = k => outConf.filter(o => Math.abs(o.qty - Number(bru.getEnvVar(k))) < 0.000001);
  const sent = c => {
    expect(c.is_send_interface, c.id).to.equal(true);
    expect(c.qty_gi, c.id).to.be.above(0);
    expect(c.qty_interface, c.id).to.be.closeTo(c.qty_gi, 0.000001);
  };

  test("return row sent", function () {
    expect(res.status).to.equal(200);
    const r = inConf.filter(x => x.document_ref_type === "MANUAL_RETURN" && x.ref_input_confirm_id === bru.getVar("usage1RowId"));
    expect(r.length).to.equal(1);
    expect(r[0].manual_status).to.equal("RETURNED");
    expect(r[0].qty).to.be.closeTo(Number(bru.getEnvVar("returnQty")), 0.000001);
    expect(r[0].is_send_interface).to.equal(true);
  });

  test("usage rows not re-sent", function () {
    usage("u1").concat(usage("u2")).forEach(sent);
  });
}
