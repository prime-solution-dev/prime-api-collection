meta {
  name: 01 Assert GR 2 (RFP + GRPO 2)
  type: http
  seq: 1
}

docs {
  รันหลัง gr-import FG gr2Qty ผ่านหน้าเว็บ /gr-import — find-open เลือกใบนี้ → output confirm แถวใหม่ → RFP #2 + GRPO-Production #2
  WMS เห็นแค่ flag; GRPO #2 ไม่รวมรอบ 1 (= ราคา PO × gr2Qty) ยืนยันใน SAP checklist
  เก็บ input id + แถว usage รอบ 1 ให้ 02 Return
}

post {
  url: {{PROD_URL}}/production/get-production-detail
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "production_code": "{{assemblyCode}}"
  }
}

script:post-response {
  const items = ((res.body || {}).data || {}).items || [];
  const p = bru.getEnvVar("u1Product");
  const input = items.flatMap(i => i.input_items || []).find(x => x.product_code === p);
  const row = ((input || {}).confirms || []).find(x => x.document_ref_type === "MANUAL_USAGE");
  if (input) bru.setVar("u1InputId", input.id);
  if (row) bru.setVar("usage1RowId", row.id);
}

tests {
  const items = res.body.data.items || [];
  const inConf = items.flatMap(i => (i.input_items || []).flatMap(x => x.confirms || []));
  const outConf = items.flatMap(i => (i.output_items || []).flatMap(x => x.confirms || []));
  // รอบ usage แยกด้วยสินค้า: รอบ 1 = u1Product, รอบ 2 = u2Product
  const usage = k => inConf.filter(x => x.document_ref_type === "MANUAL_USAGE" && x.product_code === bru.getEnvVar(k + "Product"));
  const outOf = k => outConf.filter(o => Math.abs(o.qty - Number(bru.getEnvVar(k))) < 0.000001);
  const sent = c => {
    expect(c.is_send_interface, c.id).to.equal(true);
    expect(c.qty_gi, c.id).to.be.above(0);
    expect(c.qty_interface, c.id).to.be.closeTo(c.qty_gi, 0.000001);
  };

  test("two output confirms (gr1Qty + gr2Qty), all RFP + GRPO sent", function () {
    expect(res.status).to.equal(200);
    expect(outConf.length).to.equal(2);
    expect(outOf("gr1Qty").length).to.equal(1);
    expect(outOf("gr2Qty").length).to.equal(1);
    outConf.forEach(o => {
      expect(o.is_send_interface, o.id).to.equal(true);
      expect(o.is_send_grpo, o.id).to.equal(true);
    });
  });

  test("usage rows unchanged", function () {
    usage("u1").concat(usage("u2")).forEach(sent);
  });
}
