meta {
  name: 02 Get Picks by Outbound
  type: http
  seq: 2
}

docs {
  หา picking ของ outbound (document_ref = outbound_code) ใช้ picking_code ไปพิมพ์ป้ายตะกร้า
}

post {
  url: {{API_URL}}/picking/picking/get-picks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "document_ref": ["{{outboundCode}}"],
    "page": 1,
    "page_size": 1000
  }
}

script:post-response {
  const p = (res.body.pickings || []).find((x) => x.status !== "CANCELED") || {};
  bru.setVar("pickingCode", p.picking_code);
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
  test("has picking", function () { expect(res.body.pickings.length).to.be.above(0); });
}
