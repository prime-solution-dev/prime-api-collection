meta {
  name: 18 Check Consol Location
  type: http
  seq: 18
}

docs {
  HH เช็กก่อนเริ่ม consolidate ว่า Consol Location ว่างไหม
  ไม่ว่าง = มี CTF ที่ Consol Out/In ยังไม่ COMPLETED/CANCELED ใช้ location นี้อยู่ (available=false + busy_by)
  รันหลัง 02 (CTF ยังไม่จบ) ต้องได้ available=false
}

post {
  url: {{DOC_URL}}/transfer/check-consol-location
  body: json
  auth: inherit
}

body:json {
  {
    "company_code": "{{companyCode}}",
    "site_code": "{{siteCode}}",
    "location_code": "{{consolLocation}}"
  }
}

tests {
  test("200 with availability", function () {
    expect(res.status).to.equal(200);
    expect(res.body.available).to.be.a("boolean");
    expect(res.body.busy_by).to.be.an("array");
  });
  test("busy while CTF unfinished", function () {
    expect(res.body.available).to.equal(false);
    expect(res.body.busy_by[0].location_code).to.equal(bru.getEnvVar("consolLocation"));
  });
}
