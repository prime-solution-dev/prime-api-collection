meta {
  name: 10 Complete Consol In
  type: http
  seq: 10
}

post {
  url: {{DOC_URL}}/transfer/update-transfer-complete
  body: json
  auth: inherit
}

body:json {
  {"transferId": "{{inId}}", "status": "COMPLETED"}
}

tests {
  test("completed", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Transfer completed successfully");
  });
}
