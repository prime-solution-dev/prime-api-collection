meta {
  name: Import Product
  type: http
  seq: 4
}

docs {
  Import จากไฟล์ .xlsx (sheet "Product Template") company_code / site_code ส่งทาง query
  reports ตรวจรูปแบบไฟล์แล้วส่งต่อ product-core /product/Product/import-product และคืน response ของ core ตามเดิม
  200 = {status:"success", summary, warnings}; 400 = {error, errors:[{row, column, message}]}; 502 = core ล่ม
  fixture = ผลของ request Export template (ข้อมูลตัวอย่างต้องมีใน master ของ env ที่ยิง ไม่งั้น core ตอบ 400)
}

post {
  url: {{REPORTS_URL}}/import/ImportProduct?company_code={{companyCode}}&site_code={{siteCode}}
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/product.xlsx)
}

tests {
  test("status 200 and success", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
  });
}
