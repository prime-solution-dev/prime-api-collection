meta {
  name: Login
  type: http
  seq: 1
}

docs {
  ขอ token สำหรับยิง API ของ env นั้น (Dev: user ทดสอบขอจากผู้ใช้)
  ห้ามใส่ userCode / password ใน env file — ส่งผ่าน --env-var เท่านั้น (repo นี้ public)
  npx @usebruno/cli@2 run Auth --env Dev --env-var userCode=<user> --env-var password=<pass>
  response: {"token": "<jwt>", "user": "<user_code>"} → เก็บลงตัวแปร token ของ run นี้
}

post {
  url: {{AUTH_URL}}/authen/login
  body: json
  auth: none
}

body:json {
  {
    "user_code": "{{userCode}}",
    "password": "{{password}}",
    "login_type": "PASSWORD"
  }
}

script:post-response {
  if (res.status === 200) bru.setVar("token", res.body.token);
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
  test("has token", function () { expect(res.body.token).to.be.a("string").and.not.empty; });
}
